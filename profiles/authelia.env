# Authelia as its docs recommend: users file with its default argon2id (64 MiB, t=3, p=4), SQLite, and a
# hashed (pbkdf2-sha512) client secret. The token endpoint's per-IP limit (30 a minute by default) is raised:
# an app backend sends every user's token calls from one IP, as the load generator does.
STACK=authelia
BENCH_AUTHELIA_USERS=default
