# Zitadel at 0.5 CPU / 512 MiB, hashing matched to Keycloak's default (argon2id 7 MiB, t=5, p=1).
STACK=zitadel
LIMIT_CPUS=0.5
LIMIT_MEM=536870912
ZITADEL_SYSTEMDEFAULTS_PASSWORDHASHER_HASHER_ALGORITHM=argon2id
ZITADEL_SYSTEMDEFAULTS_PASSWORDHASHER_HASHER_TIME=5
ZITADEL_SYSTEMDEFAULTS_PASSWORDHASHER_HASHER_MEMORY=7168
ZITADEL_SYSTEMDEFAULTS_PASSWORDHASHER_HASHER_THREADS=1
