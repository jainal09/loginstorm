# Best-effort Keycloak at 0.5 CPU / 512 MiB: pre-built image, Serial GC, 250 MiB heap, small pools/caches.
STACK=keycloak
LIMIT_CPUS=0.5
LIMIT_MEM=536870912
BENCH_KC_IMAGE=authbench/keycloak-optimized:26.8.1
BENCH_KC_COMMAND=start --optimized --import-realm
KC_DB_POOL_MAX_SIZE=6
KC_DB_POOL_MIN_SIZE=2
KC_HTTP_POOL_MAX_THREADS=32
JAVA_OPTS=-XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=256m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.err.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom -XX:FlightRecorderOptions=stackdepth=512 -Djdk.tls.rejectClientInitiatedRenegotiation=true -Xms250m -Xmx250m -XX:+UseSerialGC -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=20
KC_CACHE_EMBEDDED_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_CLIENT_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_OFFLINE_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_OFFLINE_CLIENT_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_USERS_MAX_COUNT=100
KC_CACHE_EMBEDDED_REALMS_MAX_COUNT=100
