# As authelia-edge-tuned, plus soak.sh's scheduled cleanup of expired OAuth2 rows:
# hourly, deleting rows older than 3 hours (longer than the 90-minute refresh-token lifespan).
STACK=authelia
LIMIT_CPUS=0.5
LIMIT_MEM=536870912
BENCH_AUTHELIA_USERS=matched
BENCH_CLEANUP_INTERVAL=3600
BENCH_CLEANUP_RETENTION_MIN=180
BENCH_AUTHELIA_CONFIG=configuration-plaintext-secret
