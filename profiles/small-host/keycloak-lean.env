# Lean Keycloak for a small host: 1 CPU and 640 MiB for Keycloak itself, with lockout, a password
# policy and refresh-token rotation on. Pre-built image, so nothing is built at boot; a fixed 256 MiB
# heap with Serial GC, which hands memory back; small database pool, thread pool and caches.
# JAVA_OPTS replaces Keycloak's default list, so it repeats that list (metaspace cap,
# ExitOnOutOfMemoryError, TLS renegotiation guard) with only G1 swapped for Serial.
STACK=keycloak
LIMIT_CPUS=1
LIMIT_MEM=671088640
RES_MEM=262144000
BENCH_KC_IMAGE=loginstorm/keycloak-optimized:26.8.1
BENCH_KC_COMMAND=start --optimized --import-realm
BENCH_KC_REALM=realm-protected
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=6
KC_HTTP_POOL_MAX_THREADS=32
JAVA_OPTS_KC_HEAP=-Xms256m -Xmx256m
JAVA_OPTS=-XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=256m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.err.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom -XX:FlightRecorderOptions=stackdepth=512 -Djdk.tls.rejectClientInitiatedRenegotiation=true -XX:+UseSerialGC -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=20
KC_CACHE_EMBEDDED_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_CLIENT_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_OFFLINE_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_OFFLINE_CLIENT_SESSIONS_MAX_COUNT=100
KC_CACHE_EMBEDDED_USERS_MAX_COUNT=100
KC_CACHE_EMBEDDED_REALMS_MAX_COUNT=100
