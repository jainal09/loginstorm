# As authelia.env, with users hashed at argon2id 7 MiB, t=5, p=1 (OWASP's lowest-memory setting, and
# Keycloak's default) instead of Authelia's 64 MiB, t=3, p=4. Authelia runs every login's hash at once,
# so memory grows by the hash's size per login in flight: 7 MiB each here, 64 MiB with the default.
STACK=authelia
BENCH_AUTHELIA_USERS=matched
