# Sourced by the runners. PROVISION prints CLIENT_ID=/CLIENT_SECRET= lines.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/-/health/ready/
BENCH_USER_PASSWORD=bench-password
PROVISION="python3 -I stacks/authentik/provision.py ${BENCH_PORT:-18443} 50"
K6_ENV="IDP=authentik ISSUER=https://authentik.bench.test:9443/application/o/bench USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES="${BENCH_AUTHENTIK_IMAGE:-ghcr.io/goauthentik/server:2026.8.5} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db ${BENCH_NAME:-bench}-worker"
VOLUMES="${COMPOSE_PROJECT_NAME:-authbench}_authentik-db ${COMPOSE_PROJECT_NAME:-authbench}_authentik-data"
DB_STATS="postgres ${BENCH_NAME:-bench}-db authentik authentik authentik_providers_oauth2_accesstoken"
