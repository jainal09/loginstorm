# Sourced by the runners. PROVISION prints the client secret.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/auth/v1/health
BENCH_USER_PASSWORD=bench-Password-123
PROVISION="python3 -I stacks/rauthy/provision.py ${BENCH_PORT:-18443} 50"
K6_ENV="IDP=rauthy ISSUER=https://rauthy.bench.test:8443/auth/v1 USER_PASSWORD=bench-Password-123 USER_DOMAIN=bench.test USER_COUNT=50"
IMAGES=ghcr.io/sebadob/rauthy:0.37.2
CONTAINERS="${BENCH_NAME:-bench}-idp"
VOLUMES=${COMPOSE_PROJECT_NAME:-loginstorm}_rauthy-data
DB_STATS="du ${COMPOSE_PROJECT_NAME:-loginstorm}_rauthy-data"
