# Sourced by the runners. PROVISION also enrolls a software passkey per user (stacks/pocket-id/enroll.js)
# and prints PASSKEYS_FILE for the bench. Pocket ID only allows https redirect URIs by default.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/healthz
PROVISION="python3 -I stacks/pocket-id/provision.py ${BENCH_PORT:-18443} ${COMPOSE_PROJECT_NAME:-loginstorm}_default stacks/pocket-id/secrets/passkeys-${BENCH_NAME:-bench}.json 50"
K6_ENV="IDP=pocket-id ISSUER=https://pocketid.bench.test:1411 REDIRECT_URI=https://bench.invalid/callback"
IMAGES=${BENCH_POCKETID_IMAGE:-ghcr.io/pocket-id/pocket-id:v2.19.1}
CONTAINERS="${BENCH_NAME:-bench}-idp"
VOLUMES=${COMPOSE_PROJECT_NAME:-loginstorm}_pocketid-data
DB_STATS="du ${COMPOSE_PROJECT_NAME:-loginstorm}_pocketid-data"
