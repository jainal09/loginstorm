# Sourced by the runners.
READY_URL=http://127.0.0.1:${BENCH_PORT2:-19000}/healthz/ready
METRICS_URL=http://127.0.0.1:${BENCH_PORT2:-19000}/metrics
K6_ENV="IDP=dex ISSUER=https://dex.bench.test:5556/dex CLIENT_SECRET=bench-secret USER_PASSWORD=bench-password USER_DOMAIN=bench.test USER_COUNT=50"
IMAGES="${BENCH_DEX_IMAGE:-ghcr.io/dexidp/dex:v2.46.1} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES=${COMPOSE_PROJECT_NAME:-loginstorm}_dex-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db dex dex refresh_token"
