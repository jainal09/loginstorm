# Sourced by the runners. PROVISION prints CLIENT_ID=/CLIENT_SECRET= lines.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/api/status
BENCH_USER_PASSWORD=bench-password
PROVISION="python3 -I stacks/logto/provision.py ${BENCH_PORT:-18443} ${BENCH_NAME:-bench}-db 50"
# Logto usernames can't contain dashes.
K6_ENV="IDP=logto ISSUER=https://logto.bench.test:3001/oidc USER_PREFIX=bench_user_ USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES="${BENCH_LOGTO_IMAGE:-svhd/logto:1.45.0} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_logto-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db postgres logto oidc_model_instances"
