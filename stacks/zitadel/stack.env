# Sourced by the runners. PROVISION prints CLIENT_ID=/CLIENT_SECRET= lines.
PRESTART="mkdir -p stacks/zitadel/pat/${BENCH_NAME:-bench} && chmod 777 stacks/zitadel/pat/${BENCH_NAME:-bench} && rm -f stacks/zitadel/pat/${BENCH_NAME:-bench}/admin.pat"
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/debug/ready
BENCH_USER_PASSWORD=Bench-Password-1!
PROVISION="python3 -I stacks/zitadel/provision.py ${BENCH_PORT:-18443} ${BENCH_NAME:-bench}-idp 50"
K6_ENV="IDP=zitadel ISSUER=https://zitadel.bench.test:8443 USER_PASSWORD=Bench-Password-1! USER_COUNT=50"
IMAGES="${BENCH_ZITADEL_IMAGE:-ghcr.io/zitadel/zitadel:v4.20.0} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES=${COMPOSE_PROJECT_NAME:-loginstorm}_zitadel-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db postgres zitadel eventstore.events2"
