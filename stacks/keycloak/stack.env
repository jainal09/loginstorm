# Sourced by the runners (see "Add a provider" in README.md).
PRESTART="docker image inspect authbench/keycloak-optimized:26.8.1 >/dev/null 2>&1 || docker build -q --build-arg KC_VERSION=26.8.1 -t authbench/keycloak-optimized:26.8.1 -f stacks/keycloak/Dockerfile.optimized stacks/keycloak"
READY_URL=https://127.0.0.1:${BENCH_PORT2:-19000}/health/ready
METRICS_URL=https://127.0.0.1:${BENCH_PORT2:-19000}/metrics
K6_ENV="IDP=keycloak ISSUER=https://keycloak.bench.test:8443/realms/bench CLIENT_SECRET=bench-secret USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES="${BENCH_KC_IMAGE:-authbench/keycloak-optimized:26.8.1} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_keycloak-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db keycloak keycloak offline_user_session"
