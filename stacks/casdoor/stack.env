# Sourced by the runners. The organization, application and users come from init_data.json,
# written fresh (with a new client secret) before each start.
BENCH_USER_PASSWORD=bench-password
PRESTART="mkdir -p stacks/casdoor/secrets && BENCH_USER_PASSWORD=bench-password python3 -I stacks/casdoor/init-data.py stacks/casdoor/secrets/init_data.json 50"
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/api/health
PROVISION="python3 -I stacks/casdoor/init-data.py --print stacks/casdoor/secrets/init_data.json"
K6_ENV="IDP=casdoor ISSUER=https://casdoor.bench.test:8443 USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES="${BENCH_CASDOOR_IMAGE:-casbin/casdoor:v4.24.0} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_casdoor-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db casdoor casdoor token"
