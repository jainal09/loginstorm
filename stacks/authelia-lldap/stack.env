# Sourced by the runners.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/api/health
BENCH_USER_PASSWORD=bench-password
BENCH_LDAP_ADMIN_PASSWORD=bench-ldap-admin-password
PROVISION="env LLDAP_URL=http://127.0.0.1:${BENCH_PORT3:-17170} LLDAP_CONTAINER=${BENCH_NAME:-bench}-db python3 -I stacks/authelia-lldap/provision.py 50"
K6_ENV="IDP=authelia ISSUER=https://auth.bench.test:9091 CLIENT_SECRET=bench-secret USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES="authelia/authelia:4.39.28 ghcr.io/lldap/lldap:v0.6.3-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db"
VOLUMES="${COMPOSE_PROJECT_NAME:-authbench}_lldap-data ${COMPOSE_PROJECT_NAME:-authbench}_authelia-lldap-data"
DB_STATS="sqlite ${COMPOSE_PROJECT_NAME:-authbench}_authelia-lldap-data oauth2_access_token_session"
CLEANUP_VOLUME=${COMPOSE_PROJECT_NAME:-authbench}_authelia-lldap-data
