# Sourced by the runners. Hydra's introspection is on its admin API, which isn't in its discovery
# document and needs no client authentication (it is meant to stay on the internal network). Hydra
# only allows https redirect URIs.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/health/ready
BENCH_USER_PASSWORD=bench-password
PROVISION="python3 -I stacks/ory/provision.py ${BENCH_PORT2:-19000} ${BENCH_PORT3:-17170} 50"
K6_ENV="IDP=ory ISSUER=https://hydra.bench.test:4444 REDIRECT_URI=https://bench.invalid/callback INTROSPECT_URL=http://hydra:4445/admin/oauth2/introspect CLIENT_SECRET=bench-secret USER_PASSWORD=bench-password USER_DOMAIN=bench.test USER_COUNT=50"
IMAGES="${BENCH_HYDRA_IMAGE:-oryd/hydra:v26.2.0} ${BENCH_KRATOS_IMAGE:-oryd/kratos:v26.2.0} ${BENCH_ORY_UI_IMAGE:-oryd/kratos-selfservice-ui-node:v26.2.0} postgres:17-alpine"
CONTAINERS="${BENCH_NAME:-bench}-idp ${BENCH_NAME:-bench}-db ${BENCH_NAME:-bench}-kratos ${BENCH_NAME:-bench}-ui"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_ory-db
DB_STATS="postgres ${BENCH_NAME:-bench}-db ory hydra hydra_oauth2_access"
