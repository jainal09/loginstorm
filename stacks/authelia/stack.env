# Sourced by the runners.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/api/health
K6_ENV="IDP=authelia ISSUER=https://auth.bench.test:9091 CLIENT_SECRET=bench-secret USER_PASSWORD=bench-password USER_COUNT=50"
IMAGES=authelia/authelia:4.39.28
CONTAINERS="${BENCH_NAME:-bench}-idp"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_authelia-data
DB_STATS="sqlite ${COMPOSE_PROJECT_NAME:-authbench}_authelia-data oauth2_access_token_session"
CLEANUP_VOLUME=${COMPOSE_PROJECT_NAME:-authbench}_authelia-data
