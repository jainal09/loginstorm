# Sourced by the runners. PROVISION prints the client secret. Kanidm rejects weak passwords and
# only allows https redirect URIs.
READY_URL=https://127.0.0.1:${BENCH_PORT:-18443}/status
BENCH_USER_PASSWORD=Bench-Quartz-Meadow-59-Lantern
PROVISION="python3 -I stacks/kanidm/provision.py ${BENCH_PORT:-18443} ${BENCH_NAME:-bench}-idp 50"
K6_ENV="IDP=kanidm ISSUER=https://kanidm.bench.test:8443/oauth2/openid/bench-client REDIRECT_URI=https://bench.invalid/callback USER_PASSWORD=Bench-Quartz-Meadow-59-Lantern USER_COUNT=50"
IMAGES=${BENCH_KANIDM_IMAGE:-kanidm/server:1.11.2}
CONTAINERS="${BENCH_NAME:-bench}-idp"
VOLUMES=${COMPOSE_PROJECT_NAME:-authbench}_kanidm-data
DB_STATS="du ${COMPOSE_PROJECT_NAME:-authbench}_kanidm-data"
